@model AnimeBookmarksV2.Models.Animev2

@{
	ViewData["Title"] = "Delete Anime";
	Layout = "_Layout";
}

<div class="container">
	<h1>Are you sure you want to delete this anime?</h1>
	<div>
		<p>
			<strong>Description:</strong>@Model.Description
		</p>
		@if(!string.IsNullOrEmpty(Model.ImagePath)){
			<img src="@Model.ImagePath" alt="Anime Image" style="max-width: 300px;" />
		}
	</div>
	<form asp-action="DeleteConfirmed" asp-controller="Anime" asp-route-id="@Model.Id" method="post">
		<button type="submit" class="btn btn-danger">Delete</button>
	</form>
</div>