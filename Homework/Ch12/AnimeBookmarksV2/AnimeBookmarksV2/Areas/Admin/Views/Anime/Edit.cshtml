@model AnimeBookmarksV2.Models.Animev2

@{
    ViewData["Title"] = "Edit";
    Layout = "_Layout";
}

<link rel="stylesheet" href="~/lib/bootstrap/bootstrap2/css/bootstrap.min.css" />

<h1>Edit Anime</h1>

<form asp-action="Edit" method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="Id" />

    <div class="form-group">
        <label for="Title">Title</label>
        <input type="text" class="form-control" id="Title" name="Title" asp-for="Title" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label for="Description">Description</label>
        <textarea class="form-control" id="Description" name="Description" asp-for="Description"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label for="AnimeLink">Anime Link</label>
        <input type="text" class="form-control" id="AnimeLink" name="AnimeLink" asp-for="AnimeLink" />
        <span asp-validation-for="AnimeLink" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="ImagePath">Image</label>
        <input type="file" name="imageFile" class="form-control" />
    </div>

    <div class="form-group">
        <label>Genres</label>
        @foreach (var genre in ViewBag.Genres)
        {
            <div class="form-check">
                <input class="form-check-input" type="checkbox" name="selectedGenres" value="@genre.Id"
                @(Model.GenreId == genre.Id ? "checked" : "") />
                <label class="form-check-label">@genre.Name</label>
            </div>
        }
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    <a href="@Url.Action("Index", "Anime", new { area = "Admin" })" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
	@{
		await Html.RenderPartialAsync("_ValidationScriptsPartial");
	}
}