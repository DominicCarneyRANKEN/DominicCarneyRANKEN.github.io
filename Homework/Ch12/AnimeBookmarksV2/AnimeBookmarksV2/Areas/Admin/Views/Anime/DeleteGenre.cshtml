@model AnimeBookmarksV2.Models.Genre

@{
    ViewData["Title"] = "Delete Genre";
    Layout = "_Layout";
}

<h1>Delete Genre</h1>

<h3>Are you sure you want to delete this genre?</h3>

<div>
    <h4>@Model.Name</h4>
</div>

<form asp-action="DeleteGenre" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger mt-2">Delete</button>
    <a asp-action="Genres" class="btn btn-dark mt-2">Back</a>
</form>
