<div class="container">
	<h1 class="text-center mb-4">Anime Bookmarks</h1>


	<form asp-action="Index" method="get" class="mb-4">
    <div class="row">
        <div class="col-md-6">
            <input type="text" name="searchTerm" class="form-control" placeholder="Search by title or description"
                   value="@Model.SearchTerm" />
        </div>
        <div class="col-md-4">
            <select name="selectedGenreId" class="form-control">
                <option value="0">All Genres</option>
					@foreach (var genre in Model.Genres)
					{
						<option value="@genre.Id" selected="@(genre.Id == Model.SelectedGenreId ? "selected" : null)">
							@genre.Name
						</option>
					}
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-dark">Filter</button>
        </div>
    </div>
</form>

	<div class="row">
		@foreach(var anime in Model.Animesv2)
		{
			<div class="col-md-4 mb-4">
				<div class="card">
					<img src="@anime.ImagePath" class="card-img-top" alt="Anime Image">
					<div class="card-body">
						<h5 class="card-title">@anime.Title</h5>
						<p class="card-text">@anime.Description</p>
						<p><strong>Genres:</strong>
							@if(anime.AnimeGenres.Any()){
								@foreach (var genre in anime.AnimeGenres){
									<span class="badge bg-secondary">@genre.Genre.Name</span>
								}
							}
							else{
								<span class="text-muted">No genres listed</span>
							}
						</p>
						@if(Context.Session.GetString("UserId") != null){
							<form asp-controller="Bookmarks" asp-action="Add" method="post">
								<input type="hidden" name="animeId" value="@anime.Id" />
								<button type="submit" class="btn btn-dark">Bookmark</button>
							</form>
						}else{
							<a href="@Url.Action("Login", "Home")" class="btn btn-dark">Login to Bookmark</a>
						}
						<a href="@Url.Action("View", "Home", new { id = anime.Id, slug = AnimeBookmarksV2.Models.Animev2.GenerateSlug(anime.Title)})"
						class="btn btn-dark">View</a>
					</div>
				</div>
			</div>
		}
	</div>
	<nav aria-label="Page navigation">
		<ul class="pagination justify-content-center">
			@for (var i = 1; i <= Math.Ceiling((decimal)Model.TotalItems / Model.PageSize); i++)
			{
				<li class="page-item @(i == Model.PageNumber ? "active" : "")">
					<a class="page-link" href="@Url.Action("Index", new { pageNumber = i, searchTerm = Model.SearchTerm })">@i</a>
                </li>
				<br />
			}
			<br />
		}
		</nav>

</div>
				