@model List<AnimeBookmarksV2.Models.UserBookmarks>
@{
    ViewData["Title"] = "Your Bookmarks";
}

<h2>Your Bookmarked Anime</h2>

@if (Model.Count == 0)
{
    <p>You haven't bookmarked any anime yet.</p>
    <a href="@Url.Action("Index", "Home")" class="btn btn-primary mt-2">
        Browse Anime
    </a>
}
else
{
        <div class="row">
        @foreach (var bookmark in Model)
        {
                    <div class="col-md-4 mb-4">
                        <div class="card">
                            <img src="@bookmark.Anime.ImagePath" class="card-img-top" alt="Anime Image">
                            <div class="card-body">
                                <h5 class="card-title">@bookmark.Anime.Title</h5>
                                <p class="card-text">@bookmark.Anime.Description</p>
                                <a href="@bookmark.Anime.AnimeLink" target="_blank" class="btn btn-dark">Watch Anime Here</a>
                                <a href="@Url.Action("View", "Home", new { id = bookmark.AnimeId, slug = AnimeBookmarksV2.Models.Animev2.GenerateSlug(bookmark.Anime.Title)})"
                                   class="btn btn-dark">View</a>
                                

                                <form method="post" asp-controller="Bookmarks" asp-action="Remove">
                                    <input type="hidden" name="animeId" value="@bookmark.AnimeId" />
                                    <button type="submit" class="btn btn-danger">Remove Bookmark</button>
                                </form>
                        <a href="@Url.Action("Index", "Home")" class="btn btn-secondary mb-3">
                            ← Back to Home
                        </a>
                            </div>
                        </div>
                    </div>
        }
        </div>
}
