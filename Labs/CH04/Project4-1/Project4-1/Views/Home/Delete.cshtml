@model Contact

<h2>Are you sure you want to delete this contact?</h2>

<div>
    <strong>First Name:</strong> @Model.FirstName
</div>
<div>
    <strong>Last Name:</strong> @Model.LastName
</div>
<div>
    <strong>Phone Number:</strong> @Model.PhoneNumber
</div>
<div>
    <strong>Email:</strong> @Model.Email
</div>
<div>
    <strong>Category:</strong> @Model.Category?.Name
</div>

<form method="post" asp-action="ConfirmDelete" asp-route-id="@Model.ContactId">
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
