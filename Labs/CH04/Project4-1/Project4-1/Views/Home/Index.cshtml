@model List<Contact>

<h2>Contact List</h2>

<a asp-action="Add" class="btn btn-primary">Add Contact</a>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>First Name</th>
            <th>Last Name</th>
            <th>Phone</th>
            <th>Email</th>
            <th>Category</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var contact in Model)
        {
            <tr>
                <td><a asp-action="View" asp-route-id="@contact.ContactId">@contact.FirstName</a></td>
                <td><a asp-action="View" asp-route-id="@contact.ContactId">@contact.LastName</a></td>
                <td>@contact.PhoneNumber</td>
                <td>@contact.Email</td>
                <td>@contact.Category?.Name</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@contact.ContactId" class="btn btn-warning">Edit</a>
                    <a asp-action="Delete" asp-route-id="@contact.ContactId" class="btn btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
