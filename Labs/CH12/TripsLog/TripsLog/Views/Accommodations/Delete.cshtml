@model TripsLog.Models.Accommodation

@{
    ViewData["Title"] = "Delete Accommodation";
}

<h1>Are you sure you want to delete this accommodation?</h1>

<div>
    <strong>Name:</strong> @Model.Name <br />
    <strong>Phone:</strong> @Model.Phone <br />
    <strong>Email:</strong> @Model.Email <br />
</div>

<form asp-action="DeleteConfirmed" asp-route-id="@Model.AccommodationId" method="post">
    <button type="submit" class="btn btn-danger">Yes, Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
