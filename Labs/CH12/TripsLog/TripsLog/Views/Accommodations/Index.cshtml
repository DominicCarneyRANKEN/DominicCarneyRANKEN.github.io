@model IEnumerable<TripsLog.Models.Accommodation>

<h1>Manage Accommodations</h1>

<p>
    <a class="btn btn-primary" href="@Url.Action("Create")">Add Accommodation</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var accommodation in Model)
        {
            <tr>
                <td>@accommodation.Name</td>
                <td>
                    <form method="post" action="@Url.Action("Delete", new { id = accommodation.AccommodationId })" onsubmit="return confirm('Are you sure you want to delete this accommodation?')">
                        <button type="submit" class="btn btn-danger">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
