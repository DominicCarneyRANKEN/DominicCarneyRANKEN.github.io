@model TripsLog.Models.Trip

@{
    ViewData["Title"] = "Delete Trip";
}

<h1>Are you sure you want to delete this trip?</h1>

<div>
    <strong>Destination:</strong> @Model.Destination <br />
    <strong>Start Date:</strong> @Model.StartDate.ToString("MM/dd/yyyy") <br />
    <strong>End Date:</strong> @Model.EndDate.ToString("MM/dd/yyyy") <br />
</div>

<form asp-action="Delete" method="post">
    @Html.AntiForgeryToken()
    <button type="submit" class="btn btn-danger">Yes, Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
