@model TripsLog.Models.Activity

@{
    ViewData["Title"] = "Delete Activity";
}

<h2>Delete Activity</h2>

<h4>Are you sure you want to delete this activity?</h4>
<div>
    <strong>Name:</strong> @Model.Name
</div>

<form asp-action="Delete" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="ActivityId" />
    <button type="submit" class="btn btn-danger mt-3">Delete</button>
    <a asp-action="Index" class="btn btn-secondary mt-3">Cancel</a>
</form>
