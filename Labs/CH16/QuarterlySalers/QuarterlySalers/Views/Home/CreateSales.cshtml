@model QuarterlySalers.Models.Sales

@{
    ViewData["Title"] = "Create Sales";
}

<h2>Create Sales</h2>

<form asp-action="CreateSales" method="post">
    <div class="form-group">
        <label asp-for="EmployId"></label>
        <select asp-for="EmployId" class="form-control">
            <option value="">Select Employee</option>
            @if (ViewData["Employees"] != null)
            {
                foreach (var employee in ViewData["Employees"] as SelectList)
                {
                    <option value="@employee.Value">@employee.Text</option>
                }
            }
            else
            {
                <option disabled>No employees available</option>
            }
        </select>
        <span asp-validation-for="EmployId" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Quarter"></label>
        <input asp-for="Quarter" class="form-control" />
        <span asp-validation-for="Quarter" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Year"></label>
        <input asp-for="Year" class="form-control" />
        <span asp-validation-for="Year" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Amount"></label>
        <input asp-for="Amount" class="form-control" />
        <span asp-validation-for="Amount" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Create Sales</button>
</form>
<div asp-validation-summary="All" class="text-danger"></div>
<a href="@Url.Action("Index", "Home")">Back to Home</a>
