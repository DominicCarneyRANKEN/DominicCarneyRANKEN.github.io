@model List<AnimeBookmarksV2.Models.ManageUserViewModel>

@{
    ViewData["Title"] = "Manage Users";
}

<h2>Manage Users</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Username</th>
            <th>Role</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.Username</td>
                <td>@user.Role</td>
                <td>
                    <form asp-area="Admin" asp-controller="Anime" asp-action="ToggleAdminRole" method="post" style="display:inline;">
                        <input type="hidden" name="id" value="@user.Id" />
                        <button type="submit" class="btn btn-sm btn-dark">
                            @(user.Role == "Admin" ? "Remove Admin" : "Make Admin")
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
