@using Project_3_1.Models
@model Project_3_1.Models.Discount
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
</head>
<body>
    <header class="bg-success text-white text-center py-3 mb-4">
        <h1>
            <i class="fas fa-money-bill-wave"></i> Price Quotation
        </h1>
    </header>


    <div class="container">
        <form asp-action="Index" method="post" class="needs-validation" novalidate>

            <div class="row mb-3">
                <label asp-for="Subtotal" class="col-sm-2 col-form-label">Subtotal:</label>
                <div class="col-sm-6">
                    <input asp-for="Subtotal" class="form-control" />
                </div>
                <div class="col-sm-4 text-danger">
                    <span asp-validation-for="Subtotal"></span>
                </div>
            </div>

            <div class="row mb-3">
                <label asp-for="Percentage" class="col-sm-2 col-form-label">Discount Percent:</label>
                <div class="col-sm-6">
                    <input asp-for="Percentage" class="form-control" />
                </div>
                <div class="col-sm-4 text-danger">
                    <span asp-validation-for="Percentage"></span>
                </div>
            </div>


            <div class="row mb-3">
                <label asp-for="DiscountAmount" class="col-sm-2 col-form-label">Discount Amount:</label>
                <div class="col-sm-6">
                    <label asp-for="DiscountAmount" class="form-control-plaintext">@Model?.DiscountAmount.ToString("C")</label>
                </div>
            </div>

            <div class="row mb-3">
                <label asp-for="Total" class="col-sm-2 col-form-label">Total:</label>
                <div class="col-sm-6">
                    <label asp-for="Total" class="form-control-plaintext">@Model?.Total.ToString("C")</label>
                </div>
            </div>


            <div class="row">
                <div class="col-sm-8 offset-sm-2 d-flex justify-content-between">
                    <button type="submit" class="btn btn-success">Calculate</button>
                    <a asp-action="Index" class="btn btn-success">Clear</a>
                </div>
            </div>
        </form>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

