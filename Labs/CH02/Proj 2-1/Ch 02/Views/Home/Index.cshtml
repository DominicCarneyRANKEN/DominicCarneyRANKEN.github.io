@using Ch_02.Models
@model Ch_02.Models.Discount
@{
	Layout = null;
}
<!DOCTYPE html>
<html>
	<head>

	</head>
	<body>
		<h1>Price Quotation</h1>
    <form asp-action="Index" method="post">
        <div>
            <label asp-for="Subtotal">Subtotal:</label>
            <input asp-for="Subtotal" />
            <span asp-validation-for="Subtotal" class="text-danger"></span>
        </div>
        <div>
            <label asp-for="Percentage">Discount percent:</label>
            <input asp-for="Percentage" />
            <span asp-validation-for="Percentage" class="text-danger"></span>
        </div>
        <div>
            <label>Discount amount:</label>
            <label>@Model?.DiscountAmount.ToString("C")</label>
        </div>
        <div>
            <label>Total:</label>
            <label>@Model?.Total.ToString("C")</label>
        </div>
        <button type="submit">Calculate</button>
        <a asp-action="Index">Clear</a>
    </form>
	</body>
</html>
