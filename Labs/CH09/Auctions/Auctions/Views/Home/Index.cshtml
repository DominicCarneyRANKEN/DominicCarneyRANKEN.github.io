@model List<Auctions.Models.Listing>

@{
    ViewData["Title"] = "Home Page";
}

@foreach(var listing in Model)
{
    <div class="container" style="background-color: rgba(138, 19,  133, 0.6); margin-top:50px; margin-bottom: 50px; padding: 20px; border-radius: 10px;">
        <div action="row">
            <div class="col col-xs-6 col-lg-5">
                <img src="~/Images/@listing.ImagePath" style="max-width: 400px; max-height: 400px;"/>
            </div>
            <div class="col col-xs-6 col-lg-5">
               <h5><a asp-action="Details" asp-route-id="@listing.Id" style="color: black;">@listing.Title</a></h5>
                   <div>@listing.Description</div>
                   <div>Bid: $@listing.Price.ToString("F2")</div>
                   <div>Listed by: @listing.User.Email</div>
            </div>
        </div>
    </div>
}
@if(!Model.Any()){
    <p>No Active Listings</p>
}