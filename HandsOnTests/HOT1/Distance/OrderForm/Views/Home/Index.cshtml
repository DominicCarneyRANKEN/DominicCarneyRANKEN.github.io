@model OrderForm.Models.Order
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Order T-Shirts</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
</head>
<body>
    <div class="container mt-5">
        <h1 class="mb-4">Order Your T-Shirts</h1>

        <form asp-action="Order" method="post">
            <div class="form-floating mb-3">
                <input asp-for="Quantity" class="form-control" placeholder="Enter Quantity" />
                <label asp-for="Quantity">Quantity</label>
                <span asp-validation-for="Quantity" class="text-danger"></span>
            </div>

         
            <div class="form-floating mb-3">
                <input asp-for="Discount" class="form-control" placeholder="Enter Discount Code (Optional)" />
                <label asp-for="Discount">Discount Code (Optional)</label>
                <span asp-validation-for="Discount" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Order Now</button>
        </form>

   
        @if (ViewBag.Subtotal != null)
        {
            <div class="mt-4">
                <h3>Order Summary</h3>
                <p><strong>Subtotal:</strong> @ViewBag.Subtotal</p>
                <p><strong>Tax:</strong> @ViewBag.Tax</p>
                <p><strong>Total:</strong> @ViewBag.Total</p>
            </div>
        }
    </div>

</body>
</html>