@model Distance.Models.Distances
@{
    Layout = null;    
}

<!DOCTYPE html>
    <html>
        <head>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">

        </head>
        <body>
        <nav class="navbar navbar-expand-lg navbar-light bg-light">
            <div class="container-fluid">
                <a class="navbar-brand" href="#">Distance Converter</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="nav-link active" href="#">Home</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>

        <div class="container mt-5">
            <h1 class="mb-4">Distance Converter</h1>
            <form asp-action="Index" method="post" class="needs-validation" novalidate>
                <div class="form-floating mb-3 w-25">
                    <input asp-for="Inches" class="form-control" type="text" id="inches" required>
                    <label for="inches">Distance in Inches</label>
                    <span class="text-danger" asp-validation-for="Inches"></span>
                </div>
                <button type="submit" class="btn btn-primary">Convert</button>
            </form>

            <div class="mt-4">
                @if (Model?.Inches.HasValue == true)
                {
                <p class="alert alert-success">@Model.FormattedInches inches is @Model.FormattedCentimeters centimeters.</p>
                }
            </div>
        </div>
    </body>
</html>
