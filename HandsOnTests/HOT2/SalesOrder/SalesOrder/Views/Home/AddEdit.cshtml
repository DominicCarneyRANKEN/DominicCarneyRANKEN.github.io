@model SalesOrder.Models.Product

@{
    ViewData["Title"] = "Add/Edit Product";
}

<h1>@ViewData["Title"]</h1>

<form asp-action="Save" method="post">
    <input type="hidden" asp-for="ProductID" /> 

    <div class="form-group">
        <label for="ProductName">Product Name</label>
        <input asp-for="ProductName" class="form-control" />
        <span asp-validation-for="ProductName" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label for="ProductImage">Product Image URL</label>
        <input asp-for="ProductImage" class="form-control" placeholder="Enter image URL" />
        <span asp-validation-for="ProductImage" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label for="ProductPrice">Product Price</label>
        <input asp-for="ProductPrice" class="form-control" />
        <span asp-validation-for="ProductPrice" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label for="ProductQty">Product Quantity</label>
        <input asp-for="ProductQty" class="form-control" />
        <span asp-validation-for="ProductQty" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label for="CategoryID">Category</label>
        <select asp-for="CategoryID" class="form-control" asp-items="ViewBag.Categories"></select>
        <span asp-validation-for="CategoryID" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label for="ProductDescShort">Short Description</label>
        <textarea asp-for="ProductDescShort" class="form-control"></textarea>
        <span asp-validation-for="ProductDescShort" class="text-danger"></span>
    </div>


    <div class="form-group">
        <label for="ProductDescLong">Long Description</label>
        <textarea asp-for="ProductDescLong" class="form-control"></textarea>
        <span asp-validation-for="ProductDescLong" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="List" class="btn btn-secondary">Cancel</a>
</form>
