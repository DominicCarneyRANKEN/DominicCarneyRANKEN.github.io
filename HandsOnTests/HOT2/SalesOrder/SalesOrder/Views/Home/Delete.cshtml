@model SalesOrder.Models.Product

@{
    ViewData["Title"] = "Delete Product";
}

<h1>@ViewData["Title"]</h1>

<h3>Are you sure you want to delete the product: @Model.ProductName?</h3>

<form method="post" asp-action="ConfirmDelete" asp-route-id="@Model.ProductID">
    <button type="submit" class="btn btn-danger">Yes, Delete</button>
    <a asp-action="List" class="btn btn-secondary">Cancel</a>
</form>
