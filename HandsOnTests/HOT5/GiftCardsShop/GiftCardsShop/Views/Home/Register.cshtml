@model GiftCardsShop.Models.RegisterViewModel
@{
	ViewData["Title"] = "Register";
}

<h2>Sign Up</h2>
<p>Already registered? <a href="@Url.Action("Login", "Home")">Click here to Login</a>.</p>

<form method="post" asp-action="register">
	<div class="mb-3">
		<label for="Username" class="form-label">Username</label>
		<input type="Username" class="form-control" id="Username" asp-for="Username" />
	</div>

	<div class="mb-3">
		<label for="Email" class="form-label">Email</label>
		<input type="Email" class="form-control" id="Email"  asp-for="Email" />
	</div>

	<div class="mb-3">
		<label for="FirstName" class="form-label">First Name</label>
		<input type="FirstName" class="form-control" id="FirstName" asp-for="FirstName"/>
	</div>

	<div class="mb-3">
		<label for="LastName" class="form-label">Last Name</label>
		<input type="LastName" class="form-control" id="Last Name" asp-for="LastName"/>
	</div>

	<div class="mb-3">
		<label for="Password" class="form-label">Password</label>
		<input type="Password" class="form-control" id="Password" asp-for="Password" />
	</div>

<button type="submit" class="btn btn-primary">Register</button>
</form>