@model AnimeBookmarks.Models.AnimeGenreViewModel



<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Anime Bookmark - Discover Your Favorite Anime</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3-alpha1/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Roboto', sans-serif;
            background-color: #f4f4f4;
        }
        .card {
            background-color: #e0e0e0;
        }
        .navbar {
            margin-bottom: 30px;
        }
        footer {
            background-color: #343a40;
            color: white;
            padding: 15px 0;
        }
    </style>
</head>
<body>

    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container-fluid">
            <a class="navbar-brand" href="#">Anime Bookmarks</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"].ToString() == "Home" && ViewContext.RouteData.Values["action"].ToString() == "Index" ? "active" : "")" href="~/Home/Index">Home</a>

                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"].ToString() == "Anime" && ViewContext.RouteData.Values["action"].ToString() == "Index" ? "active" : "")" href="@Url.Action("Index", "Anime", new { area = "Admin" })">Admin</a>

</li>
                    <li class="nav-item">
                        <a class="nav-link" href="#">About</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

 
    <div class="container">
        <h1 class="text-center mb-4"> Anime Bookmarks</h1>
        <p class="text-center mb-4">Check out some anime and feel free to bookmark</p>

        <div class="row">
            @foreach (var anime in Model.Animes)
            {
                <div class="col-md-4 mb-4">
                    <div class="card">
                        <img src="@anime.ImageUrl" class="card-img-top" alt="Anime Image">
                        <div class="card-body">
                            <h5 class="card-title">@anime.Title</h5>
                            <p class="card-text">@anime.Description</p>
                            <a href="#" class="btn btn-primary">Bookmark</a>
                            <a href="@Url.Action("View", "Home", new { id = anime.Id, slug = anime.Slug?.ToLower() ?? "" })" class="btn btn-info">View</a>
                        </div>
                    </div>
                </div>
            }
        </div>

    </div>


    <footer class="text-center">
        &copy; 2025 Anime Bookmarks. 
    </footer>
  
</body>
</html>
