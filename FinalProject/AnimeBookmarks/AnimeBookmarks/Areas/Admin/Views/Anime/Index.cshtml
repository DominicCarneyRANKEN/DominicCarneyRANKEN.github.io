@model AnimeBookmarks.Models.AnimeGenreViewModel

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin - Manage Anime</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3-alpha1/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Roboto', sans-serif;
            background-color: #f4f4f4;
        }

        .card {
            background-color: #e0e0e0;
        }

        .navbar {
            margin-bottom: 30px;
        }

        footer {
            background-color: #343a40;
            color: white;
            padding: 15px 0;
        }
    </style>
</head>
<body>

    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container-fluid">
            <a class="navbar-brand" href="#">Anime Bookmarks Admin</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"].ToString() == "Home" && ViewContext.RouteData.Values["action"].ToString() == "Index" ? "active" : "")" href="~/Home/Index">Home</a>

                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"].ToString() == "Anime" && ViewContext.RouteData.Values["action"].ToString() == "Index" ? "active" : "")" href="@Url.Action("Index", "Anime", new { area = "Admin" })">Admin</a>

                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container">
        <h1 class="text-center mb-4"> Anime Bookmarks</h1>
        <p class="text-center mb-4">Check out some anime and feel free to bookmark</p>
        <form method="get" action="@Url.Action("Index", "Anime", new { area = "Admin" })">
            <div class="row mb-4">
                <div class="col-md-6">
                    <input type="text" class="form-control" name="searchString" placeholder="Search by Anime Title" value="@Model.SearchString" />
                </div>
                <div class="col-md-6">
                    <button type="submit" class="btn btn-primary w-100">Search</button>
                </div>
            </div>
        </form>

    <div class="container">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        <h1 class="text-center mb-4">Admin - Manage Anime</h1>
        <p class="text-center mb-4">Add, Edit, or Remove anime bookmarks.</p>

        <div class="text-center mb-4">
            <a href="@Url.Action("Create", "Anime", new { area = "Admin" })" class="btn btn-success">Add New Anime</a>
        </div>

        <form method="get" class="text-center mb-4">
            <label for="genre" class="form-label">Filter by Genre:</label>
            <select name="genre" id="genre" class="form-select w-auto d-inline-block">
                <option value="">All Genres</option>
                @foreach (var genre in Model.Genres)
                {
                    <option value="@genre" selected="@(Model.SelectedGenre == genre ? "selected" : null)">
                        @genre
                    </option>
                }
            </select>
            <button type="submit" class="btn btn-primary">Filter</button>
        </form>

        <div class="row">
            @foreach (var anime in Model.Animes)
            {
                <div class="col-md-4 mb-4">
                    <div class="card">
                        <img src="@(!string.IsNullOrEmpty(anime.ImageUrl) ? anime.ImageUrl : "/images/placeholder.jpg")" class="card-img-top img-fluid" alt="Anime Image">
                        <div class="card-body">
                            <h5 class="card-title">@anime.Title</h5>
                            <p class="card-text">@anime.Description</p>
                            <a href="@Url.Action("Edit", "Anime", new { id = anime.Id, slug = anime.Slug, area = "Admin" })" class="btn btn-warning" title="Edit anime details">Edit</a>
                            <a href="@Url.Action("Delete", "Anime", new { id = anime.Id, slug = anime.Slug, area = "Admin" })" class="btn btn-danger" title="Delete this anime">Delete</a>
                        </div>
                    </div>
                </div>
            }

        </div>

        <div class="pagination">
            @if (Model.PageNumber > 1)
            {
                <a href="@Url.Action("Index", new { pageNumber = Model.PageNumber - 1, searchString = Model.SearchString, genre = Model.SelectedGenre })" class="btn btn-primary">Previous</a>
            }

            @for (var i = 1; i <= Model.TotalPages; i++)
            {
                <a href="@Url.Action("Index", new { pageNumber = i, searchString = Model.SearchString, genre = Model.SelectedGenre })" class="btn @(Model.PageNumber == i ? "btn-info" : "btn-light")">
                    @i
                </a>
            }

            @if (Model.PageNumber < Model.TotalPages)
            {
                <a href="@Url.Action("Index", new { pageNumber = Model.PageNumber + 1, searchString = Model.SearchString, genre = Model.SelectedGenre })" class="btn btn-primary">Next</a>
            }
        </div>
    </div>

    <footer class="text-center py-4">
        &copy; 2025 Anime Bookmarks Admin.
    </footer>

</body>
</html>
